{
  "name": "sensei-uaepass-workspace",
  "version": "2.0.0",
  "description": "UAE PASS authentication library for Angular with OAuth 2.0, PKCE, Signals, Arabic/RTL, and secure backend proxy support.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "start:demo": "ng serve demo --open",
    "start:proxy": "node proxy-server.js",
    "start:full": "concurrently \"npm run start:proxy\" \"npm run start:demo\"",
    "dev": "npm run start:full",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "ng build uae-pass --configuration production",
    "build:demo": "ng build demo --configuration production",
    "build:watch": "ng build uae-pass --watch --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:lib",
    "test:lib": "ng test uae-pass --watch=false --browsers=ChromeHeadless --code-coverage",
    "test:demo": "ng test demo --watch=false --browsers=ChromeHeadless",
    "lint": "eslint projects scripts --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:lint": "markdownlint-cli2 \"**/*.md\"",
    "docs:serve": "python -m http.server 8080 --directory docs",
    "clean": "rimraf dist coverage node_modules/.cache",
    "pack:lib": "npm pack ./dist/uae-pass",
    "pack:check": "npm pack ./dist/uae-pass --dry-run",
    "package:validate": "node scripts/validate-package.mjs",
    "package:lint": "publint dist/uae-pass",
    "package:types": "attw --pack --profile esm-only dist/uae-pass",
    "package:check": "npm run build:lib && npm run package:validate && npm run pack:check && npm run package:lint && npm run package:types",
    "validate": "npm run format:check && npm run lint && npm run test:lib && npm run build && npm run package:check && npm run docs:lint && npm audit --omit=dev --audit-level=high",
    "publish:lib": "npm publish ./dist/uae-pass --access public",
    "release": "npm run validate && npm run pack:lib",
    "docker:backend": "npm --prefix examples/backends/nodejs-express run docker:build",
    "docker:run": "npm --prefix examples/backends/nodejs-express run docker:run"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.1.7",
    "@angular/compiler": "^20.1.7",
    "@angular/core": "^20.1.7",
    "@angular/forms": "^20.1.7",
    "@angular/platform-browser": "^20.1.7",
    "@angular/platform-browser-dynamic": "^20.1.7",
    "@angular/router": "^20.1.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.1.7",
    "@angular-eslint/eslint-plugin": "^20.1.1",
    "@angular-eslint/eslint-plugin-template": "^20.1.1",
    "@angular-eslint/template-parser": "^20.1.1",
    "@angular/cli": "^20.1.7",
    "@angular/compiler-cli": "^20.1.7",
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "~6.0.0",
    "concurrently": "^10.0.4",
    "cors": "^2.8.5",
    "eslint": "^10.8.0",
    "express": "^5.2.1",
    "globals": "^17.8.0",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "markdownlint-cli2": "^0.23.2",
    "ng-packagr": "^20.1.0",
    "node-fetch": "^3.3.2",
    "prettier": "^3.6.2",
    "publint": "^0.3.12",
    "rimraf": "^6.0.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.38.0"
  }
}
